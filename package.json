{
  "name": "labaik-field",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace functions",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "build:check": "expo export --platform android --platform ios",
    "functions:build": "npm run build --workspace functions",
    "emulators": "npm run functions:build && firebase emulators:start --project demo-labaik-field --only auth,firestore,functions,storage",
    "seed": "node scripts/seed-local.cjs",
    "build:apk:dev": "npx eas-cli build --platform android --profile development",
    "build:apk:preview": "npx eas-cli build --platform android --profile preview",
    "config:demo": "node scripts/demo-config.cjs",
    "test:rules": "firebase emulators:exec --project demo-labaik-field --only firestore,storage \"node --import tsx --test tests/rules/security.test.ts\""
  },
  "dependencies": {
    "expo": "~54.0.37",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "~6.0.21",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-dom": "19.1.0",
    "@react-native-firebase/app": "23.5.0",
    "@react-native-firebase/auth": "23.5.0",
    "@react-native-firebase/firestore": "23.5.0",
    "@react-native-firebase/functions": "23.5.0",
    "@react-native-firebase/storage": "23.5.0",
    "expo-sqlite": "~16.0.10",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.5",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.18",
    "prettier": "^3.5.3",
    "react-test-renderer": "19.1.0",
    "typescript": "~5.9.2",
    "firebase-tools": "^15.0.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "12.4.0",
    "firebase-admin": "^13.0.0",
    "tsx": "^4.20.0"
  },
  "workspaces": [
    "functions"
  ]
}
